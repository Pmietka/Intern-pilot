# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google / Gmail API
GOOGLE_CREDENTIALS_PATH=path/to/google_credentials.json
GOOGLE_TOKEN_PATH=path/to/token.json

# Hunter.io API (optional — enables 'internpilot contacts' command)
# Free tier: 25 searches/month. Sign up at https://hunter.io
HUNTER_API_KEY=

# Optional: override default settings
LOG_LEVEL=INFO
CLAUDE_API_DELAY_SECONDS=2
BROWSER_ACTION_DELAY_SECONDS=3
